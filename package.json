{
  "name": "venilu",
  "version": "0.0.1",
  "private": true,
  "author": {
    "name": "leonardo victoriano",
    "email": "leon4rdo.dev@gmail.com"
  },
  "description": "Venilu",
  "type": "commonjs",
  "main": "dist-electron/main/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "npm run electron:dev",
    "build": "npm run electron:build",
    "build:react": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed": "node -e \"require('tsconfig-paths/register'); require('ts-node').register({ project: 'tsconfig.electron.json', transpileOnly: true }); require('./src/main/seed.ts');\"",
    "electron:dev": "concurrently \"vite\" \"cross-env NODE_ENV=development electron src/main/main-dev.js\"",
    "electron:build": "vite build && tsc -p tsconfig.electron.json && tsc-alias -p tsconfig.electron.json && electron-builder",
    "build:win": "npm run electron:build -- --win",
    "build:linux": "npm run electron:build -- --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "npmRebuild": true,
    "appId": "com.venilu.pos",
    "productName": "Venilu",
    "files": [
      "dist/",
      "dist-electron/",
      "package.json",
      "node_modules/",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!node_modules/.bin"
    ],
    "extraResources": [
      "data/database.sqlite"
    ],
    "directories": {
      "buildResources": "public/assets",
      "output": "release"
    },
    "linux": {
      "target": "deb",
      "icon": "public/assets/venilu.ico",
      "category": "Utility"
    },
    "win": {
      "target": "nsis",
      "icon": "public/assets/venilu.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "leon4rdodev",
      "repo": "Venilu-releases",
      "private": false
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.553.0",
    "react-day-picker": "^9.11.1",
    "react-router-dom": "^7.13.0",
    "recharts": "2.15.4",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.7",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "typeorm": "^0.3.28",
    "use-sync-external-store": "^1.4.0",
    "vaul": "^0.9.9",
    "zod": "3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/electron": "^1.4.38",
    "@types/node": "^22.19.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.19",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "postcss": "^8.5",
    "react-resizable-panels": "^4.6.4",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
